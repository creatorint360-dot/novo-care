# These are the NAMES of the secret settings. The real values are typed into
# Vercel > Project > Settings > Environment Variables (or Render > Environment). NEVER put real values in this file or in GitHub.
DATABASE_URL=postgres://novostaff_app:PASSWORD@YOUR-RDS-ENDPOINT:5432/postgres
PEPPER=at-least-32-random-characters
ENC_KEY=base64-of-32-random-bytes
SESSION_SECRET=at-least-32-random-characters
SETUP_TOKEN=a-secret-word-only-you-know
DEMO_MODE=true
# Optional: which kind of system this is (clinic, school, bank or staff). Default: clinic.
SYSTEM_PROFILE=clinic
# Vercel runs many copies of the server at once, so keep each copy to a couple of database connections:
# DB_POOL_MAX=2
